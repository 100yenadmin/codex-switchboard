#!/usr/bin/env python3
"""Fake codex-switchboard for the codex-logins tests. Each command's output comes from $FAKE_CS_FIXTURE:
{"status": <obj> | "!exit" | "!garbage" | "!list", "leases": ..., "switch": "!ok" | "!exit" | "!noop" | "!hang"};
"!badutf8" prints bytes that are not UTF-8. `resolve` matches a key, a handle or an email (any case) among the status
accounts, unless "resolve" maps the name to a reply ({"error": ...} replies exit 2) or is "!exit"/"!garbage"/"!badutf8".
A successful switch records its --profile-key in the fixture's "switched" list and makes that account the CLI's
active one. Exits 99 if CODEX_HOME reaches it."""
import hashlib
import json
import os
import sys

if "CODEX_HOME" in os.environ:
    sys.exit(99)
path = os.environ["FAKE_CS_FIXTURE"]
with open(path) as f:
    fx = json.load(f)
cmd = sys.argv[1]
if "--json" not in sys.argv:
    sys.exit(64)
out = fx.get(cmd, "!exit")
if cmd == "resolve":
    given = sys.argv[sys.argv.index("--profile-key") + 1]
    override = fx.get("resolve")
    if isinstance(override, dict) and given in override:
        reply = override[given]
    elif isinstance(override, str):
        out = override
        reply = None
    else:
        def handle(k):
            return "acct_" + hashlib.sha256(k.encode()).hexdigest()[:12]
        accounts = fx["status"]["accounts"] if isinstance(fx.get("status"), dict) else []
        hits = [a for a in accounts if given in (a["profile_key"], handle(a["profile_key"]))] or [
            a for a in accounts if given.strip() and str(a.get("email", "")).strip().lower() == given.strip().lower()]
        if len(hits) == 1:
            reply = {"handle": handle(hits[0]["profile_key"]), "email": hits[0].get("email", "")}
        elif hits:
            reply = {"error": "ambiguous_account", "details": ["%s pro Personal" % handle(a["profile_key"]) for a in hits]}
        else:
            reply = {"error": "unknown_profile"}
    if reply is not None:
        print(json.dumps(reply))
        sys.exit(2 if "error" in reply else 0)
if cmd == "switch":
    given = sys.argv[sys.argv.index("--profile-key") + 1]
    if out == "!hang":
        import time
        time.sleep(10)
    fx.setdefault("switched", []).append(given)
    if out == "!ok":
        keys = [a["profile_key"] for a in fx["status"]["accounts"]]
        key = next((k for k in keys if given in (k, "acct_" + hashlib.sha256(k.encode()).hexdigest()[:12])), given)
        for s in fx["status"].get("surfaces", []):
            if s.get("kind") == "cli":
                s["active_profile_key"] = key
    with open(path, "w") as f:
        json.dump(fx, f)
    if out == "!badutf8":
        sys.stdout.buffer.write(b"\xff\xfe{")
        sys.exit(0)
    if out == "!exit":
        print(json.dumps({"error": "consumers_running", "message": "a@example.invalid is busy"}))
        sys.exit(2)
    print(json.dumps({"profile_key": given, "email": "x@example.invalid"}))
    sys.exit(0)
if out == "!exit":
    print(json.dumps({"error": "lease_store_unreadable"}))
    sys.exit(2)
if out == "!badutf8":
    sys.stdout.buffer.write(b"\xff\xfe{")
    sys.exit(0)
if out == "!garbage":
    print("not json {")
    sys.exit(0)
if out == "!list":
    print("[]")
    sys.exit(0)
print(json.dumps(out))
