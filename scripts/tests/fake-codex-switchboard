#!/usr/bin/env python3
"""Fake codex-switchboard for the codex-logins tests. Each command's output comes from $FAKE_CS_FIXTURE:
{"status": <obj> | "!exit" | "!garbage" | "!list", "leases": ..., "switch": "!ok" | "!exit" | "!noop"}.
A successful switch records its --profile-key in the fixture's "switched" list and makes that account the CLI's
active one. Exits 99 if CODEX_HOME reaches it."""
import hashlib
import json
import os
import sys

if "CODEX_HOME" in os.environ:
    sys.exit(99)
path = os.environ["FAKE_CS_FIXTURE"]
with open(path) as f:
    fx = json.load(f)
cmd = sys.argv[1]
if "--json" not in sys.argv:
    sys.exit(64)
out = fx.get(cmd, "!exit")
if cmd == "switch":
    given = sys.argv[sys.argv.index("--profile-key") + 1]
    fx.setdefault("switched", []).append(given)
    if out == "!ok":
        keys = [a["profile_key"] for a in fx["status"]["accounts"]]
        key = next((k for k in keys if given in (k, "acct_" + hashlib.sha256(k.encode()).hexdigest()[:12])), given)
        for s in fx["status"].get("surfaces", []):
            if s.get("kind") == "cli":
                s["active_profile_key"] = key
    with open(path, "w") as f:
        json.dump(fx, f)
    if out == "!exit":
        print(json.dumps({"error": "consumers_running", "message": "a@example.invalid is busy"}))
        sys.exit(2)
    print(json.dumps({"profile_key": given, "email": "x@example.invalid"}))
    sys.exit(0)
if out == "!exit":
    print(json.dumps({"error": "lease_store_unreadable"}))
    sys.exit(2)
if out == "!garbage":
    print("not json {")
    sys.exit(0)
if out == "!list":
    print("[]")
    sys.exit(0)
print(json.dumps(out))
